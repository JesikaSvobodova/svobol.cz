    "check:build": "node scripts/check-build.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "test:e2e": "playwright test",
    "test:visual": "VISUAL_QA=1 playwright test tests/visual.spec.ts --project=visual",
