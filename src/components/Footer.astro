---
/**
 * Patička. Kontakty se berou ze `site.contact` — prázdné hodnoty se
 * záměrně nevykreslí, ať na webu nesvítí prázdný řádek nebo placeholder.
 */
import { site } from "@/data/site";

const { email, phone } = site.contact;
const year = new Date().getFullYear();
---

<footer class="border-t border-surface-border bg-surface-muted">
  <div
    class="container-wide flex flex-col gap-3 py-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="text-sm text-text-muted">&copy; {year} {site.name}</p>

    {
      (email || phone) && (
        <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
          {email && (
            <li>
              <a
                href={`mailto:${email}`}
                class="text-brand transition-colors hover:text-brand-dark"
              >
                {email}
              </a>
            </li>
          )}
          {phone && (
            <li>
              <a
                href={`tel:${phone.replace(/\s/g, "")}`}
                class="text-brand transition-colors hover:text-brand-dark"
              >
                {phone}
              </a>
            </li>
          )}
        </ul>
      )
    }
  </div>
</footer>
