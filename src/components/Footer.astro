---
import { site } from "@/data/site";
---

<footer class="border-t bg-brand-dark text-text-inverted" style="border-color: var(--theme-footer-border);">
  <div class="container-wide py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <!-- Column 1: Brand -->
      <div>
        <div class="mb-3 flex items-center gap-2">
          <svg class="h-7 w-7 text-brand-light" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
          </svg>
          <h3 class="text-lg font-bold text-white">{site.name}</h3>
        </div>
        <p class="text-sm leading-relaxed" style="color: var(--theme-hero-accent-soft);">
          Nabíjecí stanice Svolbox a fotovoltaické elektrárny. Instalace na klíč po celé ČR.
        </p>
        <div class="mt-4 flex gap-3">
          <a href={site.social.facebook} target="_blank" rel="noopener noreferrer"
            class="transition-colors hover:text-white" style="color: var(--theme-hero-accent-soft);">
            Facebook
          </a>
          <span style="color: var(--theme-hero-accent-soft);">·</span>
          <a href={site.social.instagram} target="_blank" rel="noopener noreferrer"
            class="transition-colors hover:text-white" style="color: var(--theme-hero-accent-soft);">
            Instagram
          </a>
        </div>
      </div>

      <!-- Column 2: Services -->
      <div>
        <h4 class="mb-3 text-sm font-semibold uppercase tracking-wider" style="color: var(--theme-hero-accent);">Služby</h4>
        <ul class="space-y-2 text-sm" style="color: var(--theme-hero-accent-soft);">
          <li><a href="/sluzby" class="transition-colors hover:text-white">Nabíjecí stanice Svolbox</a></li>
          <li><a href="/sluzby" class="transition-colors hover:text-white">Fotovoltaické elektrárny</a></li>
          <li><a href="/sluzby" class="transition-colors hover:text-white">Instalace na klíč</a></li>
          <li>
            <a href="https://svolbox.com" target="_blank" rel="noopener noreferrer"
              class="transition-colors hover:text-white">svolbox.com &rarr;</a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Contact -->
      <div>
        <h4 class="mb-3 text-sm font-semibold uppercase tracking-wider" style="color: var(--theme-hero-accent);">Kontakt</h4>
        <ul class="space-y-2 text-sm" style="color: var(--theme-hero-accent-soft);">
          <li>
            <a href={`mailto:${site.contact.email}`} class="transition-colors hover:text-white">
              {site.contact.email}
            </a>
          </li>
          <li>
            <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="transition-colors hover:text-white">
              {site.contact.phone}
            </a>
          </li>
          <li>{site.contact.company}</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t pt-6 text-center text-xs" style="border-color: var(--theme-footer-border); color: var(--theme-hero-accent-soft);">
      &copy; {new Date().getFullYear()} {site.contact.company}. Všechna práva vyhrazena.
    </div>
  </div>
</footer>
