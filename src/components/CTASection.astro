---
import { site } from "@/data/site";

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  label?: string;
}

const { eyebrow = "Technická konzultace", title, text, label = "Popsat projekt" } = Astro.props;
---

<section class="bg-brand" aria-labelledby="cta-title">
  <div class="container-wide grid gap-8 py-14 sm:py-16 lg:grid-cols-[1fr_auto] lg:items-end">
    <div>
      <p class="eyebrow eyebrow-light">{eyebrow}</p>
      <h2 id="cta-title" class="max-w-4xl text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
        {title}
      </h2>
      <p class="mt-5 max-w-2xl text-base text-blue-100 sm:text-lg">{text}</p>
    </div>
    <a class="btn-primary w-full sm:w-auto" href={site.contactCta.href}
      >{label}<span aria-hidden="true">→</span></a
    >
  </div>
</section>
