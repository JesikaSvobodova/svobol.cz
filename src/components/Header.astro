---
/**
 * Hlavička webu. Navigace se generuje ze `site.nav` — položky přidávej tam,
 * ne sem. Když je `site.nav` prázdné, vykreslí se jen logo.
 */
import { site } from "@/data/site";

const currentPath = Astro.url.pathname;
const hasNav = site.nav.length > 0;

const isActive = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

<header class="border-b border-surface-border bg-surface">
  <nav class="container-wide flex items-center justify-between py-4">
    <a
      href="/"
      class="text-lg font-bold tracking-tight text-brand-dark transition-colors hover:text-brand sm:text-xl"
    >
      {site.name}
    </a>

    {
      hasNav && (
        <>
          <ul class="hidden items-center gap-1 md:flex">
            {site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "rounded-lg px-4 py-2 text-sm font-medium transition-colors",
                    isActive(item.href)
                      ? "bg-brand-lighter text-brand-dark"
                      : "text-text-muted hover:bg-surface-muted hover:text-text",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>

          <button
            id="menu-toggle"
            class="rounded-lg p-2 text-text-muted transition-colors hover:bg-surface-muted md:hidden"
            aria-label="Otevřít menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
              />
            </svg>
          </button>
        </>
      )
    }
  </nav>

  {
    hasNav && (
      <div id="mobile-menu" class="hidden border-t border-surface-border md:hidden">
        <ul class="container-wide flex flex-col gap-1 py-4">
          {site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "block rounded-lg px-4 py-3 text-base font-medium transition-colors",
                  isActive(item.href)
                    ? "bg-brand-lighter text-brand-dark"
                    : "text-text-muted hover:bg-surface-muted hover:text-text",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</header>

<script>
  // Mobilní menu. Existuje jen když má web navigaci, proto opatrné hledání.
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Zavřít menu" : "Otevřít menu");
  });
</script>
