---
import Wordmark from "@/components/Wordmark.astro";
import { site } from "@/data/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-surface-border bg-white/95 backdrop-blur-sm">
  <nav
    class="container-wide flex min-h-[4.25rem] items-center justify-between gap-5"
    aria-label="Hlavní navigace"
  >
    <a href="/" class="shrink-0 no-underline" aria-label="svobol — domů">
      <Wordmark />
    </a>

    <div class="hidden min-w-0 items-center gap-1 lg:flex">
      <ul class="flex items-center gap-0.5">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "block rounded px-3 py-2 text-[0.79rem] font-semibold no-underline transition-colors xl:px-3.5 xl:text-sm",
                  isActive(item.href)
                    ? "bg-brand-pale text-brand"
                    : "text-text-muted hover:bg-surface-muted hover:text-brand-ink",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={site.contactCta.href}
        class="ml-2 inline-flex min-h-11 items-center rounded bg-brand px-4 text-sm font-bold text-white no-underline transition-colors hover:bg-brand-deep"
      >
        {site.contactCta.label}
      </a>
    </div>

    <details class="mobile-menu relative lg:hidden">
      <summary
        class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded border border-surface-border text-brand-ink"
        aria-label="Otevřít navigaci"
      >
        <span class="sr-only">Menu</span>
        <svg
          class="menu-open h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          class="menu-close hidden h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </summary>
      <div
        class="fixed inset-x-0 top-[4.25rem] border-y border-surface-border bg-white shadow-soft"
      >
        <ul class="container-wide flex flex-col py-3">
          {
            site.nav.map((item) => (
              <li class="border-b border-surface-border last:border-0">
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "flex min-h-12 items-center px-1 py-3 font-semibold no-underline",
                    isActive(item.href) ? "text-brand" : "text-brand-ink",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="pt-3">
            <a
              href={site.contactCta.href}
              class="flex min-h-12 items-center justify-center rounded bg-brand text-sm font-bold text-white no-underline"
            >
              {site.contactCta.label}
            </a>
          </li>
        </ul>
      </div>
    </details>
  </nav>
</header>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  details[open] .menu-open {
    display: none;
  }

  details[open] .menu-close {
    display: block;
  }
</style>
