<figure class="energy-diagram" aria-labelledby="energy-diagram-title energy-diagram-desc">
  <svg viewBox="0 0 560 430" role="img">
    <title id="energy-diagram-title">Řízený energetický systém</title>
    <desc id="energy-diagram-desc"
