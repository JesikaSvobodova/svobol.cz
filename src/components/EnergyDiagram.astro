      řízení výkonu.</desc
    >
    <defs>
      <marker id="arrow-orange" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
        <path d="M0 0 9 4.5 0 9Z" fill="var(--color-accent)"></path>
      </marker>
      <marker id="arrow-blue" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
        <path d="M0 0 9 4.5 0 9Z" fill="#6f8ce5"></path>
      </marker>
    </defs>

    <path class="flow flow-blue" d="M146 84H245V170"></path>
    <path class="flow flow-blue" d="M146 215H219"></path>
    <path class="flow flow-blue" d="M146 346H245V260"></path>
    <path class="flow flow-orange" d="M341 215H414"></path>
    <path class="flow flow-orange" d="M315 170V84H414"></path>
    <path class="flow flow-orange" d="M315 260V346H414"></path>

    <g class="node">
      <rect x="18" y="48" width="128" height="72" rx="4"></rect>
      <text x="34" y="76" class="node-code">ZDROJ</text>
      <text x="34" y="101" class="node-label">FVE</text>
    </g>
    <g class="node">
      <rect x="18" y="179" width="128" height="72" rx="4"></rect>
      <text x="34" y="207" class="node-code">AKUMULACE</text>
      <text x="34" y="232" class="node-label">Baterie</text>
    </g>
    <g class="node">
      <rect x="18" y="310" width="128" height="72" rx="4"></rect>
      <text x="34" y="338" class="node-code">ROZHRANÍ</text>
      <text x="34" y="363" class="node-label">Síť</text>
    </g>

    <g class="control">
      <rect x="219" y="170" width="122" height="90" rx="4"></rect>
      <path d="M247 198h25l-11 18h21l-31 24 9-17h-20Z" fill="var(--color-accent)"></path>
      <text x="280" y="205" class="control-code">DATA</text>
      <text x="280" y="228" class="control-label">Řízení</text>
    </g>

    <g class="node">
      <rect x="414" y="48" width="128" height="72" rx="4"></rect>
      <text x="430" y="76" class="node-code">ODBĚR</text>
      <text x="430" y="101" class="node-label">Spotřeba</text>
    </g>
    <g class="node">
      <rect x="414" y="179" width="128" height="72" rx="4"></rect>
      <text x="430" y="207" class="node-code">MOBILITA</text>
      <text x="430" y="232" class="node-label">EV</text>
    </g>
    <g class="node">
      <rect x="414" y="310" width="128" height="72" rx="4"></rect>
      <text x="430" y="338" class="node-code">TOK</text>
      <text x="430" y="363" class="node-label node-label-small">Import / export</text>
    </g>
  </svg>
  <figcaption>Měření → rozhodnutí → řízení výkonu</figcaption>
</figure>

<style>
