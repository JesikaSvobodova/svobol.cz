  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .flow {
    fill: none;
    stroke-width: 2;
  }

  .flow-blue {
    stroke: #6f8ce5;
    marker-end: url(#arrow-blue);
  }

  .flow-orange {
    stroke: var(--color-accent);
    marker-end: url(#arrow-orange);
  }

  .node rect {
