---
import { site } from "@/data/site";
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-dark via-brand-dark to-brand">
  <!-- Dot pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>
  <!-- Glow -->
  <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full opacity-10" style="background: radial-gradient(circle, var(--color-brand-light), transparent 70%);"></div>

  <div class="container-wide relative py-20 md:py-28 lg:py-36">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <!-- Text -->
      <div class="text-center md:text-left">
        <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-sm font-semibold uppercase tracking-wider backdrop-blur-sm" style="color: var(--theme-hero-accent);">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
          </svg>
          Svolbox partner
        </p>
        <h1 class="mb-4 text-4xl font-bold leading-tight text-white md:text-5xl lg:text-6xl">
          {site.hero.headline}
        </h1>
        <p class="mb-8 max-w-lg text-base leading-relaxed md:text-lg" style="color: var(--theme-hero-accent-soft);">
          {site.hero.subheadline}
        </p>
        <div class="flex flex-col gap-3 sm:flex-row sm:justify-center md:justify-start">
          <a href={site.hero.ctaLink} class="btn-primary bg-white !text-brand-dark hover:!bg-gray-50">
            {site.hero.ctaText}
          </a>
          <a href={site.hero.secondaryCtaLink} class="btn-outline !border-current hover:!bg-white/10 hover:!text-white" style="color: var(--theme-hero-accent); border-color: var(--theme-hero-accent) !important;">
            {site.hero.secondaryCtaText}
          </a>
        </div>
      </div>

      <!-- Visual -->
      <div class="flex justify-center md:justify-end">
        <div class="relative">
          <div class="relative flex h-72 w-72 items-center justify-center rounded-2xl sm:h-80 sm:w-80 lg:h-96 lg:w-96" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
            <!-- EV charger SVG illustration -->
            <svg class="h-48 w-48 opacity-90" viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Body -->
              <rect x="20" y="20" width="80" height="110" rx="10" fill="#166534" stroke="#4ADE80" stroke-width="2"/>
              <!-- Screen -->
              <rect x="30" y="30" width="60" height="40" rx="5" fill="#14532D"/>
              <text x="60" y="56" text-anchor="middle" fill="#4ADE80" font-size="20" font-weight="bold" font-family="monospace">22kW</text>
              <!-- Status light -->
              <circle cx="60" cy="85" r="8" fill="#4ADE80" opacity="0.9"/>
              <!-- Cable -->
              <path d="M60 130 Q60 145 40 155" stroke="#4ADE80" stroke-width="4" stroke-linecap="round" fill="none"/>
              <!-- Plug -->
              <rect x="28" y="150" width="24" height="12" rx="3" fill="#4ADE80"/>
              <!-- Bolt icon on screen -->
              <path d="M55 38 L50 50 L58 50 L53 62 L65 46 L57 46 L62 38Z" fill="#4ADE80" opacity="0.3"/>
            </svg>
            <!-- Floating badge -->
            <div class="absolute -bottom-4 -right-4 rounded-xl bg-white px-4 py-2 text-sm font-semibold text-brand-dark shadow-lg">
              Svolbox partner
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
