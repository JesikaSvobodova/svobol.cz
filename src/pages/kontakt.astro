---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
---

<BaseLayout
  title={`Kontakt — ${site.name}`}
  description="Kontaktujte Svobol — nabíjecí stanice Svolbox a fotovoltaika. Nezávazná konzultace zdarma."
>
  <!-- Header -->
  <section class="relative overflow-hidden bg-brand-dark py-16 md:py-24">
    <div class="absolute -left-20 -top-20 h-80 w-80 rounded-full opacity-5" style="background: radial-gradient(circle, white, transparent 70%);"></div>
    <div class="container-narrow relative text-center">
      <h1 class="text-4xl text-white md:text-5xl">Kontakt</h1>
      <p class="mt-4 text-lg" style="color: var(--theme-hero-accent-soft);">
        Nezávazná konzultace zdarma. Odpovíme do 48 hodin.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-wide">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <!-- Email -->
        <div class="rounded-2xl border border-surface-border bg-white p-8 transition-shadow hover:shadow-md">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-lighter text-brand">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-brand-dark">Email</h3>
          <a href={`mailto:${site.contact.email}`} class="text-brand underline underline-offset-2 hover:text-brand-dark">
            {site.contact.email}
          </a>
        </div>

        <!-- Telefon -->
        <div class="rounded-2xl border border-surface-border bg-white p-8 transition-shadow hover:shadow-md">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-lighter text-brand">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-brand-dark">Telefon</h3>
          <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="text-brand underline underline-offset-2 hover:text-brand-dark">
            {site.contact.phone}
          </a>
        </div>

        <!-- Svolbox -->
        <div class="rounded-2xl border border-surface-border bg-white p-8 transition-shadow hover:shadow-md">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-lighter text-brand">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-brand-dark">Svolbox</h3>
          <a href="https://svolbox.com" target="_blank" rel="noopener noreferrer" class="text-brand underline underline-offset-2 hover:text-brand-dark">
            svolbox.com
          </a>
          <p class="mt-2 text-sm text-text-muted">Oficiální web nabíjecích stanic</p>
        </div>
      </div>

      <!-- Poptávkový formulář -->
      <div class="mt-12 rounded-2xl border border-surface-border bg-surface-muted p-8 md:p-12">
        <h2 class="mb-2 text-2xl text-brand-dark">Napšte nám</h2>
        <p class="mb-8 text-text-muted">Popište vaši situaci a my se ozvíme s nabídkou.</p>
        <form
          method="POST"
          action={`mailto:${site.contact.email}`}
          enctype="text/plain"
          class="grid gap-6 sm:grid-cols-2"
        >
          <div>
            <label class="mb-1.5 block text-sm font-medium text-brand-dark" for="name">Jméno *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full rounded-lg border border-surface-border bg-white px-4 py-3 text-sm transition focus:border-brand focus:outline-none focus:ring-2"
              style="--tw-ring-color: var(--color-brand-lighter);"
            />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-medium text-brand-dark" for="email">Email *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full rounded-lg border border-surface-border bg-white px-4 py-3 text-sm transition focus:border-brand focus:outline-none focus:ring-2"
              style="--tw-ring-color: var(--color-brand-lighter);"
            />
          </div>
          <div class="sm:col-span-2">
            <label class="mb-1.5 block text-sm font-medium text-brand-dark" for="interest">Zajímá mě</label>
            <select
              id="interest"
              name="interest"
              class="w-full rounded-lg border border-surface-border bg-white px-4 py-3 text-sm transition focus:border-brand focus:outline-none focus:ring-2"
              style="--tw-ring-color: var(--color-brand-lighter);"
            >
              <option value="nabijeci-stanice">Nabíjecí stanice Svolbox</option>
              <option value="fotovoltaika">Fotovoltaické elektrárna</option>
              <option value="obe">Obě služby</option>
            </select>
          </div>
          <div class="sm:col-span-2">
            <label class="mb-1.5 block text-sm font-medium text-brand-dark" for="message">Zpráva *</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Popište vaši situaci (typ objektu, počet aut, střecha...)&quot;
              class="w-full rounded-lg border border-surface-border bg-white px-4 py-3 text-sm transition focus:border-brand focus:outline-none focus:ring-2"
              style="--tw-ring-color: var(--color-brand-lighter);"
            ></textarea>
          </div>
          <div class="sm:col-span-2">
            <button type="submit" class="btn-primary">
              Odeslat poptávku
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
