---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Kontakt pro technický projekt | svobol";
const description =
  "Kontaktujte svobol s.r.o. kvůli projektu FVE, baterie, energetického řízení, Victron nebo nabíjení elektromobilů. Technické detaily jsou vítané.";
const mailto = `mailto:${site.contact.email}?subject=${encodeURIComponent(site.contact.emailSubject)}`;
const pageUrl = `${site.url}/kontakt`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "svobol", item: site.url },
    { "@type": "ListItem", position: 2, name: "Kontakt", item: pageUrl },
  ],
};
---

<BaseLayout {title} {description} {structuredData}>
  <section class="dark-noise surface-grid text-white">
    <div
      class="container-wide grid gap-12 py-16 sm:py-20 lg:grid-cols-[1.06fr_0.94fr] lg:items-end lg:py-24"
    >
      <div>
        <Breadcrumbs current="Kontakt" />
        <p class="eyebrow eyebrow-light">Technická konzultace</p>
        <h1 class="max-w-4xl text-[clamp(2.9rem,7vw,6rem)] font-bold leading-[0.94] text-white">
          Popište nám projekt.<br /><span class="text-brand-orange">Detaily jsou vítané.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-xl">
          Napište, co dnes funguje, co nefunguje a jakého výsledku chcete dosáhnout. Schéma, měření
          nebo seznam zařízení nám pomohou začít konkrétně.
        </p>
      </div>

      <div class="border border-white/15 bg-white/[0.04] p-6 sm:p-8">
        <p class="tech-label !text-blue-200">Přímý kontakt</p>
        <a
          class="mt-6 block break-all text-2xl font-bold text-white hover:text-brand-orange sm:text-3xl"
          href={mailto}>{site.contact.email}</a
        >
        <p class="mt-2 text-xs leading-relaxed text-slate-400">
          Veřejný firemní kontakt společnosti svobol s.r.o., používaný také pro produkt Svolbox.
        </p>
        <a
          class="mt-4 block text-xl font-bold text-white hover:text-brand-orange"
          href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a
        >
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="btn-primary" href={mailto}>Napsat e-mail <span aria-hidden="true">→</span></a>
          <a class="btn-secondary" href={`tel:${site.contact.phoneHref}`}>Zavolat</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-space" aria-labelledby="co-poslat">
    <div class="container-wide grid gap-12 lg:grid-cols-[0.74fr_1.26fr] lg:gap-20">
      <div>
        <p class="eyebrow">Aby první hovor byl věcný</p>
        <h2 id="co-poslat" class="section-title">Co je dobré poslat rovnou</h2>
        <p class="section-lead">
          Nemusíte mít hotové zadání. Stačí známé skutečnosti a otázky, které potřebujete vyřešit.
        </p>
      </div>
      <ol class="grid gap-px bg-surface-border sm:grid-cols-2">
        <li class="bg-white p-6 sm:p-8">
          <span class="tech-label">01 / Cíl</span><h3 class="mt-6 text-xl font-bold">
            Požadované chování
          </h3><p class="mt-4 text-sm leading-relaxed text-text-muted">
            Co má systém dělat jinak než dnes a podle čeho poznáme správný výsledek.
          </p>
        </li>
        <li class="bg-white p-6 sm:p-8">
          <span class="tech-label">02 / Stav</span><h3 class="mt-6 text-xl font-bold">
            Současné technologie
          </h3><p class="mt-4 text-sm leading-relaxed text-text-muted">
            FVE, měniče, baterie, nabíječky, měření, přípojka a dostupná rozhraní.
          </p>
        </li>
        <li class="bg-white p-6 sm:p-8">
          <span class="tech-label">03 / Data</span><h3 class="mt-6 text-xl font-bold">
            Spotřeba a výkon
          </h3><p class="mt-4 text-sm leading-relaxed text-text-muted">
            Průběhová data, hlavní jištění, výkonové špičky nebo alespoň roční spotřeba.
          </p>
        </li>
        <li class="bg-white p-6 sm:p-8">
          <span class="tech-label">04 / Kontext</span><h3 class="mt-6 text-xl font-bold">
            Místo a termín
          </h3><p class="mt-4 text-sm leading-relaxed text-text-muted">
            Typ objektu, lokalita, fáze projektu a rozhodnutí, která mají časový limit.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="bg-surface-muted section-space" aria-labelledby="firemni-udaje">
    <div class="container-wide grid gap-12 lg:grid-cols-[0.74fr_1.26fr] lg:gap-20">
      <div>
        <p class="eyebrow">Ověřené údaje</p>
        <h2 id="firemni-udaje" class="section-title">{site.legalName}</h2>
        <p class="section-lead">
          Právní údaje ověřené ve veřejném rejstříku. Sídlo není prezentováno jako návštěvní
          provozovna.
        </p>
      </div>
      <dl class="border-y border-surface-border">
        <div class="grid gap-2 border-b border-surface-border py-5 sm:grid-cols-[10rem_1fr]">
          <dt class="tech-label">Sídlo</dt><dd>
            {site.company.address.map((line) => <span class="block">{line}</span>)}
          </dd>
        </div>
        <div class="grid gap-2 border-b border-surface-border py-5 sm:grid-cols-[10rem_1fr]">
          <dt class="tech-label">IČO</dt><dd class="font-semibold">{site.company.ico}</dd>
        </div>
        <div class="grid gap-2 border-b border-surface-border py-5 sm:grid-cols-[10rem_1fr]">
          <dt class="tech-label">DIČ</dt><dd class="font-semibold">{site.company.dic}</dd>
        </div>
        <div class="grid gap-2 py-5 sm:grid-cols-[10rem_1fr]">
          <dt class="tech-label">Rejstřík</dt><dd>{site.company.registry}</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>
