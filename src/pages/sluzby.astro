---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
---

<BaseLayout
  title={`Služby — ${site.name}`}
  description="Instalace nabíjecích stanic Svolbox a fotovoltaických elektráren. Kompletní servis na klíč."
>
  <!-- Header -->
  <section class="relative overflow-hidden bg-brand-dark py-16 md:py-24">
    <div class="absolute -left-20 -top-20 h-80 w-80 rounded-full opacity-5" style="background: radial-gradient(circle, white, transparent 70%);"></div>
    <div class="container-narrow relative text-center">
      <h1 class="text-4xl text-white md:text-5xl">Naše služby</h1>
      <p class="mt-4 text-lg" style="color: var(--theme-hero-accent-soft);">
        Nabíjecí stanice, fotovoltaika a vše kolem — od konzultace po spuštění.
      </p>
    </div>
  </section>

  <!-- Nabíjecí stanice -->
  <section class="py-16 md:py-24">
    <div class="container-wide">
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div>
          <div class="mb-4 h-1 w-16 rounded-full" style="background: var(--color-brand-light);"></div>
          <h2 class="mb-4 text-3xl md:text-4xl">Nabíjecí stanice Svolbox</h2>
          <p class="mb-6 leading-relaxed text-text-muted">
            Svolbox je český výrobce nabíjecích stanic pro elektromobily s výkony od 7,4 kW (AC) do
            150 kW (DC). Jako certifikovaný partner zajišťujeme kompletní dodávku a instalaci.
          </p>
          <ul class="mb-8 space-y-3">
            {[
              "Rodinné domy a garaže (wallbox 7,4–22 kW)",
              "Bytové domy a HOA (sdílené naбíjecí)",
              "Firemní parkoviště a flotily",
              "Veřejná rychlo-nabíjení (DC 50–150 kW)",
              "Správa a vzdálené monitorování",
            ].map((item) => (
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-brand" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span class="text-text-muted">{item}</span>
              </li>
            ))}
          </ul>
          <a href="https://svolbox.com" target="_blank" rel="noopener noreferrer" class="btn-primary">
            svolbox.com
          </a>
        </div>
        <div class="rounded-2xl bg-surface-muted p-10 text-center">
          <svg class="mx-auto h-48 w-48" viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="20" y="20" width="80" height="110" rx="10" fill="#dcfce7" stroke="#16A34A" stroke-width="2"/>
            <rect x="30" y="30" width="60" height="40" rx="5" fill="#14532D"/>
            <text x="60" y="56" text-anchor="middle" fill="#4ADE80" font-size="20" font-weight="bold" font-family="monospace">22kW</text>
            <circle cx="60" cy="85" r="8" fill="#16A34A"/>
            <path d="M60 130 Q60 145 40 155" stroke="#16A34A" stroke-width="4" stroke-linecap="round" fill="none"/>
            <rect x="28" y="150" width="24" height="12" rx="3" fill="#16A34A"/>
          </svg>
          <p class="mt-4 text-sm font-medium text-brand-dark">Svolbox wallbox</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FVE -->
  <section class="bg-surface-muted py-16 md:py-24">
    <div class="container-wide">
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div class="order-2 md:order-1 rounded-2xl bg-white p-10 text-center shadow-sm">
          <svg class="mx-auto h-48 w-48" viewBox="0 0 200 160" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Sun -->
            <circle cx="100" cy="40" r="20" fill="#FCD34D" opacity="0.9"/>
            <line x1="100" y1="10" x2="100" y2="2" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
            <line x1="100" y1="78" x2="100" y2="70" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
            <line x1="70" y1="40" x2="62" y2="40" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
            <line x1="138" y1="40" x2="130" y2="40" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
            <line x1="79" y1="19" x2="73" y2="13" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
            <line x1="127" y1="67" x2="121" y2="61" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
            <line x1="121" y1="19" x2="127" y2="13" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
            <line x1="73" y1="67" x2="79" y2="61" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
            <!-- Panels -->
            <rect x="20" y="95" width="70" height="45" rx="3" fill="#14532D" stroke="#16A34A" stroke-width="1.5"/>
            <line x1="55" y1="95" x2="55" y2="140" stroke="#16A34A" stroke-width="1" opacity="0.5"/>
            <line x1="20" y1="117" x2="90" y2="117" stroke="#16A34A" stroke-width="1" opacity="0.5"/>
            <rect x="110" y="95" width="70" height="45" rx="3" fill="#14532D" stroke="#16A34A" stroke-width="1.5"/>
            <line x1="145" y1="95" x2="145" y2="140" stroke="#16A34A" stroke-width="1" opacity="0.5"/>
            <line x1="110" y1="117" x2="180" y2="117" stroke="#16A34A" stroke-width="1" opacity="0.5"/>
          </svg>
          <p class="mt-4 text-sm font-medium text-brand-dark">Fotovoltaické panely</p>
        </div>
        <div class="order-1 md:order-2">
          <div class="mb-4 h-1 w-16 rounded-full" style="background: var(--color-brand-light);"></div>
          <h2 class="mb-4 text-3xl md:text-4xl">Fotovoltaické elektrárny</h2>
          <p class="mb-6 leading-relaxed text-text-muted">
            Navrhujeme a montujeme fotovoltaické elektrárny na míru — pro rodinné domy i průmyslové
            objekty. Snížení nákladů, nezlávislost na síti a nížký čOP.
          </p>
          <ul class="mb-8 space-y-3">
            {[
              "Návrh a projektová dokumentace",
              "Panelovoné soustavy na střecho i přístavníky",
              "Hybridní střídač + baterové úložiště",
              "Vyřízení připojení k síti (PPDS)",
              "Vyřízení dotace NZB 2030 / OPŽP",
            ].map((item) => (
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-brand" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span class="text-text-muted">{item}</span>
              </li>
            ))}
          </ul>
          <a href="/kontakt" class="btn-primary">Nezávazná konzultace</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Proces -->
  <section class="py-16 md:py-24">
    <div class="container-narrow">
      <div class="mb-10 text-center">
        <div class="mx-auto mb-4 h-1 w-16 rounded-full" style="background: var(--color-brand-light);"></div>
        <h2 class="mb-3 text-3xl md:text-4xl">Jak to funguje</h2>
        <p class="text-text-muted">Od poptávky po spuštění běžně do 4 týdnů.</p>
      </div>
      <ol class="space-y-6">
        {[
          { n: "1", title: "Konzultace", text: "Zdarma, bez závazku. Zjistíme vaše potřeby a připravíme nabídku." },
          { n: "2", title: "Projekt a smlouva", text: "Zpracujeme technický projekt, zařídíme povolení a podepíšeme smlouvu." },
          { n: "3", title: "Instalace", text: "Certifikovaný tým provede montun obvykle během 1–2 dní." },
          { n: "4", title: "Spuštění a servis", text: "Předání v provozuschopném stavu, záruka a pozáruční podpora." },
        ].map((step) => (
          <li class="flex gap-6 rounded-2xl border border-surface-border bg-white p-6">
            <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-brand-lighter text-xl font-bold text-brand">
              {step.n}
            </div>
            <div>
              <h3 class="mb-1 text-lg text-brand-dark">{step.title}</h3>
              <p class="text-text-muted">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
