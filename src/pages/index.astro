---
/**
 * Homepage. Texty se berou ze `site.home` v src/data/site.ts.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
---

<BaseLayout title={site.title} description={site.description}>
  <section class="container-narrow flex min-h-[60vh] flex-col justify-center py-20 text-center">
    <div class="mx-auto mb-6 h-1 w-16 rounded-full bg-brand"></div>

    <h1 class="mb-4 text-4xl md:text-5xl">{site.home.headline}</h1>

    <p class="text-lg text-text-muted">{site.home.subheadline}</p>
  </section>
</BaseLayout>
