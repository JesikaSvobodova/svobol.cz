---
import CTASection from "@/components/CTASection.astro";
import EnergyDiagram from "@/components/EnergyDiagram.astro";
import { site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { home } = site;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  inLanguage: "cs",
  description: site.description,
};
---

<BaseLayout title={site.title} description={site.description} {structuredData}>
  <section class="dark-noise surface-grid text-white">
    <div
      class="container-wide grid gap-12 py-14 sm:py-20 lg:min-h-[42rem] lg:grid-cols-[1.04fr_0.96fr] lg:items-center lg:py-24"
    >
      <div>
        <p class="eyebrow eyebrow-light">{home.hero.eyebrow}</p>
        <h1
          class="max-w-4xl text-[clamp(3.15rem,7.2vw,6.7rem)] font-bold leading-[0.91] text-white"
        >
          {
            home.hero.headline.map((word, index) => (
              <span
                class:list={[
                  "block",
                  index === home.hero.headline.length - 1 && "text-brand-orange",
                ]}
              >
                {word}
              </span>
            ))
          }
        </h1>
        <p class="mt-7 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-xl">
          {home.hero.lead}
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="btn-primary" href={home.hero.primaryCta.href}
            >{home.hero.primaryCta.label}<span aria-hidden="true">→</span></a
          >
          <a class="btn-secondary" href={home.hero.secondaryCta.href}
            >{home.hero.secondaryCta.label}</a
          >
        </div>
      </div>
      <div class="lg:pl-4">
        <EnergyDiagram />
      </div>
    </div>
  </section>

  <section class="section-space" aria-labelledby="typicke-problemy">
    <div class="container-wide">
      <div class="grid gap-8 lg:grid-cols-[1fr_0.8fr] lg:items-end">
        <div>
          <p class="eyebrow">{home.problemsIntro.eyebrow}</p>
          <h2 id="typicke-problemy" class="section-title">{home.problemsIntro.title}</h2>
        </div>
        <p class="max-w-reading text-base text-text-muted lg:justify-self-end sm:text-lg">
          {home.problemsIntro.text}
        </p>
      </div>
      <div class="mt-12 grid gap-px bg-surface-border lg:grid-cols-3">
        {
          home.problems.map((problem) => (
            <article class="card-line flex min-h-[24rem] flex-col">
              <p class="font-mono text-xs font-bold text-brand-orange-text">{problem.number}</p>
              <h3 class="mt-12 text-2xl font-bold sm:text-3xl">{problem.title}</h3>
              <p class="mt-5 text-sm leading-relaxed text-text-muted sm:text-base">
                {problem.text}
              </p>
              <p class="mt-auto border-t border-surface-border pt-6 text-sm font-semibold text-brand">
                {problem.outcome}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="oblasti" class="bg-surface-muted section-space" aria-labelledby="oblasti-title">
    <div class="container-wide grid gap-12 lg:grid-cols-[0.68fr_1.32fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">{home.areasIntro.eyebrow}</p>
        <h2 id="oblasti-title" class="section-title">{home.areasIntro.title}</h2>
        <p class="section-lead">{home.areasIntro.text}</p>
      </div>
      <div class="grid gap-px bg-surface-border sm:grid-cols-2">
        {
          home.areas.map((area, index) => (
            <a
              class="group flex min-h-64 flex-col bg-white p-6 no-underline transition-colors hover:bg-brand-ink sm:min-h-[18rem] sm:p-8"
              href={area.href}
            >
              <div class="flex items-center justify-between">
                <span class="tech-label group-hover:text-blue-200">{area.code}</span>
                <span class="font-mono text-xs text-text-faint group-hover:text-slate-400">
                  0{index + 1}
                </span>
              </div>
              <h3 class="mt-auto text-2xl font-bold group-hover:text-white sm:text-3xl">
                {area.title}
              </h3>
              <p class="mt-4 text-sm leading-relaxed text-text-muted group-hover:text-slate-300">
                {area.text}
              </p>
              <span class="mt-6 font-bold text-brand group-hover:text-brand-orange">
                Detail oblasti <span aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-space" aria-labelledby="svolbox-title">
    <div class="container-wide overflow-hidden bg-brand">
      <div class="grid lg:grid-cols-[0.78fr_1.22fr]">
        <div
          class="surface-grid flex min-h-72 flex-col justify-between bg-brand-ink p-7 sm:p-10 lg:min-h-[31rem]"
        >
          <p class="tech-label !text-blue-200">PRODUCT / 01</p>
          <div>
            <div class="flex items-center gap-3 text-white">
              <svg viewBox="0 0 20 28" width="20" height="28" aria-hidden="true"
                ><path d="M11.3 0 1.5 14h6.8L6.8 28 18.5 12.7h-7L11.3 0Z" fill="var(--color-accent)"
                ></path></svg
              >
              <span class="text-4xl font-extrabold tracking-[-0.05em]">svolbox</span>
            </div>
            <p
              class="mt-5 max-w-sm font-mono text-xs font-bold uppercase leading-relaxed tracking-[0.14em] text-slate-400"
            >
              Hardware · elektronika · software · provoz
            </p>
          </div>
        </div>
        <div class="p-7 text-white sm:p-10 lg:p-14">
          <p class="eyebrow eyebrow-light">{home.svolbox.eyebrow}</p>
          <h2 id="svolbox-title" class="text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
            {home.svolbox.title}
          </h2>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-blue-100 sm:text-lg">
            {home.svolbox.text}
          </p>
          <p
            class="mt-6 max-w-2xl border-l-2 border-brand-orange pl-5 text-sm leading-relaxed text-white sm:text-base"
          >
            {home.svolbox.proof}
          </p>
          <a
            class="btn-primary mt-8"
            href={home.svolbox.cta.href}
            target="_blank"
            rel="noopener noreferrer">{home.svolbox.cta.label}<span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-dark text-white section-space" aria-labelledby="layers-title">
    <div class="container-wide grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
      <div>
        <p class="eyebrow eyebrow-light">{home.layersIntro.eyebrow}</p>
        <h2 id="layers-title" class="section-title !text-white">{home.layersIntro.title}</h2>
        <p class="mt-6 max-w-reading text-base text-slate-300 sm:text-lg">
          {home.layersIntro.text}
        </p>
      </div>
      <ol class="border-y border-white/15">
        {
          home.layers.map((layer) => (
            <li class="grid grid-cols-[2.2rem_1fr] gap-3 border-b border-white/15 py-5 last:border-0 sm:grid-cols-[3rem_0.7fr_1.3fr] sm:items-center sm:gap-5">
              <span class="font-mono text-[0.65rem] font-bold text-brand-orange">{layer.code}</span>
              <strong class="text-white">{layer.label}</strong>
              <span class="col-start-2 text-sm text-slate-400 sm:col-start-auto">{layer.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section-space" aria-labelledby="reference-title">
    <div class="container-wide">
      <div class="grid gap-8 lg:grid-cols-[1fr_0.8fr] lg:items-end">
        <div>
          <p class="eyebrow">{home.referencesIntro.eyebrow}</p>
          <h2 id="reference-title" class="section-title">{home.referencesIntro.title}</h2>
        </div>
        <p class="max-w-reading text-base text-text-muted lg:justify-self-end sm:text-lg">
          {home.referencesIntro.text}
        </p>
      </div>
      <div class="mt-12 grid gap-px bg-surface-border lg:grid-cols-3">
        {
          site.references.map((reference) => (
            <article class="flex min-h-80 flex-col bg-white p-6 sm:p-8">
              <p class="tech-label">{reference.type}</p>
              <h3 class="mt-9 text-2xl font-bold">{reference.title}</h3>
              <p class="mt-5 text-sm leading-relaxed text-text-muted">{reference.summary}</p>
              <a class="text-link mt-auto pt-8" href="/realizace">
                Případová studie
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    eyebrow={home.finalCta.eyebrow}
    title={home.finalCta.title}
    text={home.finalCta.text}
    label={home.finalCta.cta.label}
  />
</BaseLayout>
